# Copy to .env for local development: cp .env.example .env
# All settings are optional — the defaults below are what the app uses if unset.

# local | ci | staging | production
TAWI_ENVIRONMENT=local

TAWI_HOST=0.0.0.0
TAWI_PORT=8000

# critical | error | warning | info | debug | trace
TAWI_LOG_LEVEL=info

# Postgres connection (asyncpg driver). The default matches docker-compose.yml:
# TAWI_DATABASE_URL=postgresql+asyncpg://tawi:tawi@127.0.0.1:5433/tawi

# REQUIRED outside local/ci — the app refuses to start elsewhere without it.
# Generate one: openssl rand -hex 32
TAWI_JWT_SECRET=

# TAWI_ACCESS_TOKEN_TTL_SECONDS=900
# TAWI_REFRESH_TOKEN_TTL_SECONDS=2592000
# TAWI_PAIRING_CODE_TTL_SECONDS=900
