# Copy to .env for local development: cp .env.example .env
# All settings are optional — the defaults below are what the app uses if unset.

# local | ci | staging | production
TAWI_ENVIRONMENT=local

TAWI_HOST=0.0.0.0
TAWI_PORT=8000

# critical | error | warning | info | debug | trace
TAWI_LOG_LEVEL=info
